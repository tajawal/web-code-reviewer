# Example environment variables for local testing
# Copy this file to .env.local and fill in your actual values
# DO NOT COMMIT .env.local - it contains secrets!

# Required: Your Claude API key (get from https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Optional: Your OpenAI API key (if using OpenAI instead of Claude)
# OPENAI_API_KEY=sk-your-key-here

# Optional: GitHub token (only needed if you want to test PR comment posting)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here

# Optional: Override repository name
# GITHUB_REPOSITORY=your-username/your-repo

# Optional: Configuration overrides
# LLM_PROVIDER=claude
# LANGUAGE=js
# PATH_TO_FILES=src/
# BASE_BRANCH=master
# MAX_TOKENS=8000
# TEMPERATURE=0
# TEAM=test-team
# DEPARTMENT=engineering
